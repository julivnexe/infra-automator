# =============================================================================
# infra-automator — environment configuration
# Copy to `.env` and fill in your secrets. Never commit `.env`.
# =============================================================================

# --- Cloud provider ---------------------------------------------------------
# Which Terraform stack `infra up` should use. One of: vultr | digitalocean
INFRA_PROVIDER=vultr

# Vultr API key — https://my.vultr.com/settings/#settingsapi
VULTR_API_KEY=

# DigitalOcean personal access token — https://cloud.digitalocean.com/account/api/tokens
DIGITALOCEAN_TOKEN=

# --- Infrastructure shape ---------------------------------------------------
# Logical environment name (becomes a tag/label on every resource).
INFRA_ENV=dev

# Region slug. Vultr: ewr, lax, fra, ...   DigitalOcean: nyc3, fra1, sgp1, ...
INFRA_REGION=ewr

# Server plan/size slug.
# Vultr: vc2-1c-1gb   DigitalOcean: s-1vcpu-1gb
INFRA_PLAN=vc2-1c-1gb

# Number of servers to provision.
INFRA_NODE_COUNT=1

# --- SSH --------------------------------------------------------------------
# Local paths to the SSH keypair used for provisioning + hardening.
SSH_PUBLIC_KEY=~/.ssh/id_ed25519.pub
SSH_PRIVATE_KEY=~/.ssh/id_ed25519

# Non-root admin user created during hardening.
ADMIN_USER=deploy

# --- Hardening --------------------------------------------------------------
# SSH port after hardening. Keep on 22 unless you have a reason.
SSH_PORT=22

# Additional TCP ports to open in UFW, comma-separated. 22/SSH and the deploy
# ports (80, 443) are added automatically.
EXTRA_OPEN_PORTS=

# --- Deployment -------------------------------------------------------------
# Compose project name for the deployed stack.
COMPOSE_PROJECT=infra-app

# Image tag used by the sample app in deploy/docker-compose.yml.
APP_IMAGE_TAG=latest
