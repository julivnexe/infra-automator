* text=auto eol=lf

# Bash scripts MUST stay LF — they run on Linux servers.
*.sh    text eol=lf
*.bash  text eol=lf

# Yaml / Terraform / Ansible files are consumed by Linux tooling.
*.yml   text eol=lf
*.yaml  text eol=lf
*.tf    text eol=lf

# Python / docs — LF is fine and keeps diffs clean across platforms.
*.py    text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.cfg   text eol=lf
*.conf  text eol=lf

# Binary file types — never normalize.
*.png   binary
*.jpg   binary
*.gif   binary
*.ico   binary
