# Sample inventory. The real one is generated by `infra up` at
# .infra/inventory.yml — this file is only for manual runs.
all:
  hosts:
    node-01:
      ansible_host: 203.0.113.10
    node-02:
      ansible_host: 203.0.113.11
  vars:
    ansible_user: root
    ansible_ssh_private_key_file: ~/.ssh/id_ed25519
    admin_user: deploy
    ssh_port: 22
    extra_open_ports: []
